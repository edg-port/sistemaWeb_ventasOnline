@model IEnumerable<sistemaWeb_ventasOnline.Models.ReporteVentasViewModel>

@{
    ViewData["Title"] = "Reporte de Ventas";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<style>
    body {
        background-color: #fff9f2;
    }
    .report-table {
        border-collapse: collapse;
        width: 100%;
    }
    .report-table th, .report-table td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: center;
    }
    .report-table th {
        background-color: #f4c542;
        color: white;
    }
    .total-row {
        font-weight: bold;
    }
</style>

<div class="container mt-4">
    <h2 class="text-center">@ViewData["Title"]</h2>
    
    <p><strong>Reporte hasta el dia:</strong> 28/02/2025</p>

    <table class="table table-striped report-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Fecha de compra</th>
                <th>Nombre del cliente</th>
                <th>Id producto</th>
                <th>Categoría</th>
                <th>Nombre del producto</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @{ int contador = 1; }
            @foreach (var venta in Model)
            {
                <tr>
                    <td>@contador</td>
                    <td>@venta.FechaCompra.ToString("dd/MM/yyyy")</td>
                    <td>@venta.NombreCliente</td>
                    <td>@venta.IdProducto</td>
                    <td>@venta.Categoria</td>
                    <td>@venta.NombreProducto</td>
                    <td>$@venta.Precio.ToString("0.00")</td>
                    <td>@venta.Cantidad</td>
                    <td>$@venta.Total.ToString("0.00")</td>
                </tr>
                contador++;
            }
        </tbody>
    </table>
</div>